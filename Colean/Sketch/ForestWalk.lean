import Colean.DataCmd

/-! # Scratch: what `data Forest` produces, step by step

The declarations below are generated by the command; the `#check`s show them in the order of
`theory.typ`: the signature (step A), the occurrence structure in `X` (step B), the fixpoint
and its contract, and the constructor-level container lemmas. -/

universe u

namespace Walk

noncomputable section

data Forest (X : Type u)
  | nil
  | cons (t : X) (f : Forest X)

/-! ## Step A: the signature

The user-facing functor `F`: the constructor list with `Forest X` replaced by a variable. -/
#check @Forest.F
#check @Forest.F.nil
#check @Forest.F.cons
#check @Forest.F.map

/-! The shapes: the constructors with their non-recursive data (`nil`, `cons t`); the positions
`B`: one per recursive argument, indexed by the shape (`cons_f` under `cons`). -/
#check @Forest.Shape
#check @Forest.Shape.cons
#check @Forest.B
#check @Forest.B.cons_f

/-! ## Step B: the occurrence structure in `X`

The erased shapes: the values of `X` removed (`cons` without `t`); the parameter positions
`P`: one per value of `X` a shape held (`cons_t` under `cons`); and the isomorphism
`Shape X ≃ Σ s₀, P s₀ → X` (`cons t ↔ (cons, () ↦ t)`). -/
#check @Forest.Shape₀
#check @Forest.Shape₀.cons
#check @Forest.P
#check @Forest.P.cons_t
#check @Forest.shapeEquiv

/-! The parameterised signature: erased shapes, parameter positions, recursive positions over
the erased shapes; `Forest.sig X` is the signature at `X`, whose shapes are `Shape X`
presented through `shapeEquiv`. -/
#check @Forest.psig
#check @Forest.sig

/-! ## The fixpoint and its contract -/
#print Forest
#check @Forest.toC
#check @Forest.ofC
#check @Forest.ctor
#check @Forest.fold
#check @Forest.fold_ctor
#check @Forest.rec
#check @Forest.contract

/-! ## The occurrence structure in the parameter

`Sh` are the erased trees (the type at the erased signature: lists of units), `Pos sh` a node
of `sh` with a parameter position of its erased shape (a `cons` node with its `cons_t`), and
`Forest X ≃ Σ sh, Pos sh → X` is the structure `Forest.occ`, registered as a leaf. -/
#check @Forest.Sh
#check @Forest.Pos
#check @Forest.occ
#check @Forest.instOccLeaf
#check Codata.Occ.toC Forest.occ

/-! The structure computed on the constructors: the map and the relator. -/
#check @Forest.map_nil
#check @Forest.map_cons
#check @Forest.rel_nil
#check @Forest.rel_cons

end

end Walk
